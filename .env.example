# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Discord ---
# Bot token from the Discord Developer Portal. Required.
DISCORD_TOKEN=

# Application ID from the Discord Developer Portal. Required for slash
# command sync in some flows; also useful for building invite URLs.
DISCORD_APPLICATION_ID=

# Comma-separated list of guild IDs to sync slash commands to immediately
# during development. Leave empty to sync globally (slower propagation).
DISCORD_DEV_GUILD_IDS=

# --- Database ---
# SQLAlchemy async URL. Default points at the volume-mounted /data directory.
DATABASE_URL=sqlite+aiosqlite:////data/c3p0.db

# --- Metrics ---
METRICS_HOST=0.0.0.0
METRICS_PORT=8000

# --- Internal music control-plane API ---
# Authenticates c3p0-web's live now-playing/queue/transport calls to this
# process (app/music/internal_api.py) - required by BOTH the c3p0 and
# c3p0-web services, and must be the exact same value for both (this file
# is loaded by both, via compose.yaml's env_file:, so setting it once here
# is enough). Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_PORT=8100

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to "true" for human-readable console logs instead of JSON.
LOG_HUMAN=false

# --- Bot defaults ---
# Initial default command prefix for new guilds (overridable per guild via
# /config prefix).
DEFAULT_PREFIX=!

# --- Web dashboard (c3p0-web service) ---
# OAuth2 client secret from the Discord Developer Portal's OAuth2 page.
# DISCORD_APPLICATION_ID (above) doubles as the client ID.
DISCORD_CLIENT_SECRET=

# The exact public URL the dashboard is reachable at (via Cloudflare
# Tunnel), no trailing slash - e.g. https://c3p0.example.com. Must
# byte-for-byte match the redirect URI registered in the Discord
# Developer Portal (${PUBLIC_BASE_URL}/auth/callback).
PUBLIC_BASE_URL=

WEB_HOST=0.0.0.0
WEB_PORT=8080

# Where c3p0-web reaches the bot's internal music control-plane API (see
# INTERNAL_API_TOKEN above). The default already matches c3p0's Compose
# service name and INTERNAL_API_PORT - only change this if you renamed
# the service or the port.
BOT_INTERNAL_BASE_URL=http://c3p0:8100

# Set to "false" only for local http:// development without the tunnel in
# front - cookies won't be marked Secure, so never do this in production.
WEB_COOKIE_SECURE=true

# --- Cloudflare Tunnel ---
# Only needed if you're running a *dedicated* cloudflared service for
# C3P0 (see docs/web-dashboard.md). If you're routing through a tunnel
# container you already run for other services, leave this blank -
# c3p0-web's published port (8080) is what that tunnel reaches instead.
CLOUDFLARE_TUNNEL_TOKEN=
